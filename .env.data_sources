# QuantumVestAI Data Source Configuration
# This file demonstrates how to configure data source priorities

# Twitter Sentiment Configuration
# Set to true only if you have proper Twitter API credentials with sufficient access
ENABLE_TWITTER_SENTIMENT=false

# Premium Data Source Priority
# When true, prioritizes Yahoo Finance and Alpha Vantage over social media sources
PRIORITIZE_PREMIUM_SOURCES=true

# Alpha Vantage Configuration (Premium Source)
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Yahoo Finance is used automatically as fallback and doesn't require API keys
# This ensures reliable stock data even when other APIs are unavailable

# Twitter API Configuration (Optional - only set if you have premium Twitter access)
# TWITTER_BEARER_TOKEN=your_twitter_bearer_token
# TWITTER_API_KEY=your_twitter_api_key  
# TWITTER_API_SECRET=your_twitter_api_secret
# TWITTER_ACCESS_TOKEN=your_twitter_access_token
# TWITTER_ACCESS_SECRET=your_twitter_access_secret

# News API Configuration (Optional)
# NEWS_API_KEY=your_news_api_key