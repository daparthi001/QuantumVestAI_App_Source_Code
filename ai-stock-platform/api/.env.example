# Application settings
APP_NAME=QuantumVestAI API
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=5000

# Security
SECRET_KEY=change_this_to_a_random_secure_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/quantumvestai
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=quantumvestai
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# CORS
CORS_ORIGINS=http://quantumvestai-dev-api:8000,http://ui-service:3000

# External APIs
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key
YAHOO_FINANCE_API_KEY=your_yahoo_finance_api_key

# Feature toggles
ENABLE_BACKTESTING=true
ENABLE_REALTIME_UPDATES=true
ENABLE_SENTIMENT_ANALYSIS=true

# Deployment
DOCKER_REGISTRY=your-registry.io