# Application Settings
VERSION=1.0.0
PROJECT_NAME=QuantumVestAI
DEBUG=false
ENVIRONMENT=development

# Pod Information
POD_NAME=local-pod
POD_NAMESPACE=default

# Database Settings
POSTGRES_SERVER=localhost
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=quantumvestai_dev
POSTGRES_PORT=5432

# Twitter API Settings (replace with actual values)
TWITTER_CONSUMER_KEY=dummy_key
TWITTER_CONSUMER_SECRET=dummy_secret
TWITTER_ACCESS_TOKEN=dummy_token
TWITTER_ACCESS_SECRET=dummy_token_secret

# Application Secrets
JWT_SECRET=development_secret_key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_password
ADMIN_EMAIL=admin@example.com
ALPHA_VANTAGE_API_KEY=dummy_key

# CORS Settings
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080