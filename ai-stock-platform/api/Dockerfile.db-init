# DB Initialization Image
FROM python:3.10-slim

# Set build arguments and metadata
ARG BUILD_DATE="2025-05-20 06:39:14"
ARG VERSION="1.0.0"
ARG MAINTAINER="daparthi001"

LABEL maintainer="${MAINTAINER}" \
      created="${BUILD_DATE}" \
      version="${VERSION}" \
      description="QuantumVestAI Database Initialization"

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create necessary directories
RUN mkdir -p /app/models \
    /app/core \
    /app/db \
    /app/scripts \
    /app/alembic

# Copy requirements and configuration files first (for better layer caching)
COPY requirements.txt .
COPY alembic.ini .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY models/ /app/models/
COPY core/ /app/core/
COPY db/ /app/db/
COPY alembic/ /app/alembic/
COPY scripts/ /app/scripts/
COPY __init__.py /app/__init__.py

# Make scripts executable
RUN chmod +x /app/scripts/*.sh && \
    chmod -R 644 /app/models /app/core /app/db /app/alembic && \
    chmod 755 /app/models /app/core /app/db /app/alembic /app/scripts

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    TZ=UTC \
    CREATED_BY="daparthi001" \
    CREATED_DATE="2025-05-20 06:39:14"

# Set up a non-root user
RUN adduser --disabled-password --gecos "" dbuser && \
    chown -R dbuser:dbuser /app
USER dbuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD pg_isready -h $DB_HOST -U $DB_USER -d $DB_NAME || exit 1

ENTRYPOINT ["/app/scripts/db-init-entrypoint.sh"]
