# DB Initialization Image
FROM python:3.10-slim

# Set build arguments and metadata
ARG BUILD_DATE="2025-05-20 06:19:05"
ARG VERSION="1.0.0"
ARG MAINTAINER="daparthi001"

LABEL maintainer="${MAINTAINER}" \
      created="${BUILD_DATE}" \
      version="${VERSION}" \
      description="QuantumVestAI Database Initialization"

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .
COPY alembic.ini .
COPY alembic/ /app/alembic/
COPY scripts/ /app/scripts/

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code needed for migrations
COPY api/models/ /app/api/models/
COPY api/core/ /app/api/core/
COPY api/db/ /app/api/db/

# Make scripts executable
RUN chmod +x /app/scripts/*.sh

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    TZ=UTC \
    CREATED_BY="daparthi001" \
    CREATED_DATE="2025-05-20 06:19:05"

# Set up a non-root user
RUN adduser --disabled-password --gecos "" dbuser && \
    chown -R dbuser:dbuser /app
USER dbuser

ENTRYPOINT ["/app/scripts/db-init-entrypoint.sh"]