# DB Initialization Image
FROM python:3.10-slim

# Set build arguments and metadata
ARG BUILD_DATE="2025-05-20 06:39:14"
ARG VERSION="1.0.0"
ARG MAINTAINER="daparthi001"

LABEL maintainer="${MAINTAINER}" \
      created="${BUILD_DATE}" \
      version="${VERSION}" \
      description="QuantumVestAI Database Initialization"

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create necessary directories
RUN mkdir -p /app/api/models \
    /app/api/core \
    /app/api/db \
    /app/api/scripts \
    /app/alembic

# Copy requirements and configuration files first (for better layer caching)
COPY requirements.txt .
COPY alembic.ini .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY api/ /app/api/
COPY alembic/ /app/
COPY scripts/ /app/api/scripts/

# Copy the entire api package to ensure all modules (main.py, __init__.py, etc.) are present
COPY api/ /app/api/

# Make scripts executable
RUN chmod +x /app/api/scripts/*.sh && \
    find /app/api/models /app/api/core /app/api/db /app/alembic -type f -exec chmod 644 {} + && \
    find /app/api/models /app/api/core /app/api/db /app/alembic -type d -exec chmod 755 {} + && \
    chmod 755 /app/api/scripts

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/ai-stock-platform:/app/ai-stock-platform/api:/app/api:/app \
    TZ=UTC \
    CREATED_BY="daparthi001" \
    CREATED_DATE="2025-05-20 06:39:14"

# Set up a non-root user
RUN adduser --disabled-password --gecos "" dbuser && \
    chown -R dbuser:dbuser /app
USER dbuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD pg_isready -h $DB_HOST -U $DB_USER -d $DB_NAME || exit 1

ENTRYPOINT ["/app/api/scripts/db-init-entrypoint.sh"]
