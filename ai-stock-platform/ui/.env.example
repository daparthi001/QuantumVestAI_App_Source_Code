# QuantumVestAI UI Environment Configuration

# Application Settings
ENV=development
DEBUG=true
# This key must match the API SECRET_KEY for JWT validation
SECRET_KEY=your-secret-key-here
PORT=8000
HOST=0.0.0.0
WORKERS=4
LOG_LEVEL=debug

# API Configuration
API_BASE_URL=http://quantumvestai-dev-api:8000/api
API_TIMEOUT=10

# HTTP Client Configuration
HTTPX_CONNECT_TIMEOUT=5.0
HTTPX_READ_TIMEOUT=30.0
HTTPX_WRITE_TIMEOUT=10.0
HTTPX_POOL_TIMEOUT=10.0
HTTPX_MAX_KEEPALIVE=20
HTTPX_MAX_CONNECTIONS=100
HTTPX_KEEPALIVE_EXPIRY=30.0
HTTPX_MAX_RETRIES=3
HTTPX_RETRY_DELAY_BASE=1.0
HTTPX_RETRY_DELAY_MAX=60.0
HTTPX_VERIFY_SSL=true

# Session Settings
SESSION_COOKIE_NAME=quantumvest_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
SESSION_LIFETIME=86400  # 24 hours in seconds

# OAuth Configuration (if needed)
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=

# External Services
REDIS_URL=redis://localhost:6379/0
# SENTRY_DSN=

# Rate limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=20/minute

# CORS Settings
CORS_ORIGINS=http://ui-service,http://quantumvestai-dev-api:8000
CORS_ALLOW_CREDENTIALS=true

# Caching
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=300