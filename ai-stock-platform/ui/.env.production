# QuantumVestAI UI Production Configuration
ENV=production
DEBUG=false
# SECRET_KEY is injected via Kubernetes Secret
PORT=80
HOST=0.0.0.0
WORKERS=4
LOG_LEVEL=info

# API Configuration
API_BASE_URL=http://quantumvestai-dev-api.dev.svc.cluster.local:8000/api
API_TIMEOUT=10

# CORS Settings
CORS_ORIGINS=http://ui-service:80,http://quantumvestai-dev-api.dev.svc.cluster.local:8000
CORS_ALLOW_CREDENTIALS=true
