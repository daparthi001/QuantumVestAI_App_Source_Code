# QuantumVestAI UI Production Configuration
ENV=production
DEBUG=false
# SECRET_KEY is injected via Kubernetes Secret
PORT=3000
HOST=0.0.0.0
WORKERS=4
LOG_LEVEL=info

# API Configuration
API_BASE_URL=http://quantumvestai-dev-api:8000/api
API_TIMEOUT=10

# CORS Settings
CORS_ORIGINS=http://ui-service:3000,http://quantumvestai-dev-api:8000
CORS_ALLOW_CREDENTIALS=true
